{
  "name": "idle-quest-app",
  "version": "1.1.3",
  "description": "ETERNAL IDLE 데스크탑 앱 (jopo.kr) — 작은 창으로 띄워두는 방치형 RPG",
  "main": "main.js",
  "author": "JOPO",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "kr.jopo.idle-quest",
    "productName": "IDLE QUEST",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "JOPO02",
      "repo": "idle-quest-app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.games"
    },
    "nsis": {
      "artifactName": "IDLE-QUEST-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}
